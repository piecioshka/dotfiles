# CLI tools used by the shell configs and aliases. Install with: brew bundle

# Shell and files
brew "bat" # cat with syntax highlighting and paging
brew "eza" # ls replacement with colors, icons and a tree mode
brew "fd" # find replacement with a simpler syntax
brew "fzf" # fuzzy finder, powers the interactive shell widgets
brew "glow" # markdown renderer, used by the yazi preview
brew "jq" # JSON processor, used by scripts and the yazi preview
brew "lla" # detailed directory listings
brew "mc" # Midnight Commander
brew "ncdu" # disk usage browser, finds what eats the space
brew "ripgrep" # rg
brew "tree" # prints a directory as a tree
brew "unar" # extracts archives, used by the yazi opener
brew "watch" # reruns a command on an interval
brew "yazi" # terminal file manager
brew "entr" # run a command when files change
brew "most" # pager, used when installed
brew "tmux" # terminal multiplexer, keeps sessions alive

# System monitors
brew "btop" # resource monitor with a mouse-driven UI
brew "htop" # process viewer
brew "fastfetch" # system summary printed on shell start

# Network and media
brew "httpie" # http, https
brew "nmap" # port scanner
brew "wget" # alias: download
brew "yt-dlp" # downloads video and audio from streaming sites
brew "exiftool" # alias: exif-clean

# Git
brew "git" # newer than the macOS built-in one
brew "git-gui" # gitk
brew "git-delta" # syntax-highlighted diffs, set as the git pager
brew "difftastic" # difft
brew "tig" # text-mode interface for browsing git history
brew "gh" # GitHub CLI

# Language version managers
brew "rbenv" # Ruby versions
brew "pyenv" # Python versions

# Fonts
cask "font-fira-code-nerd-font" # set "FiraCode Nerd Font" in the terminal
