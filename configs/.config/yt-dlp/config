# default to mp4 with h264 and aac, plays everywhere
-f bv*[vcodec^=avc1][ext=mp4]+ba[ext=m4a]/bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]/b
--merge-output-format mp4

# do not overwrite, do not download the playlist when a single video link is given
--no-overwrites
--no-playlist

# metadata and thumbnail embedded in the file
--embed-metadata
--embed-thumbnail

# subtitles for the aliases that write them; with --write-subs and --write-auto-subs a manual track wins over an automatic one
--sub-langs pl,en-orig,en
--convert-subs srt

# keep file names sane, long titles are cut to 150 bytes (macOS limit is 255)
--restrict-filenames
-o "%(title).150B [%(id)s].%(ext)s"

# faster, no fuss on errors
--concurrent-fragments 4
--ignore-errors
--progress
